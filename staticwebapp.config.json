{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "always",
  "routes": [
    {
      "route": "/",
      "redirect": "/pt-BR/",
      "statusCode": 308
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/_next/*", "/*.{ico,svg,png,jpg,jpeg,webp,avif,gif,txt,xml,json,woff2,woff,ttf,otf,css,js,map}"]
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
